   logic        multdiv_valid;
   logic        multdiv_sel;
+  logic        multdiv_dec_sel;
   logic [31:0] alu_imd_val_q[2];
   logic [31:0] alu_imd_val_d[2];
   logic [ 1:0] alu_imd_val_we;
@@ -73,10 +74,34 @@ module ibex_ex_block #(
     At synthesis time, all the combinational and sequential logic
     from the multdiv_i module are eliminated
   */
-  if (RV32M != RV32MNone) begin : gen_multdiv_m
-    assign multdiv_sel = mult_sel_i | div_sel_i;
+  if (RV32M == RV32MSlow) begin : gen_multdiv_slow_sel
+    logic multdiv_active_q;
+
+    assign multdiv_dec_sel = mult_sel_i | div_sel_i;
+    assign multdiv_sel     = multdiv_active_q;
+
+    // The slow unit captures its decoder and register-file inputs on the
+    // first execution cycle. Register the datapath selection at the same
+    // boundary so the instruction decoder cannot become the select input of
+    // the shared 33-bit ALU mux all the way to the IMD registers.
+    always_ff @(posedge clk_i or negedge rst_ni) begin
+      if (!rst_ni) begin
+        multdiv_active_q <= 1'b0;
+      end else if (!multdiv_active_q) begin
+        multdiv_active_q <= mult_en_i | div_en_i;
+      end else if (multdiv_valid && multdiv_ready_id_i) begin
+        multdiv_active_q <= 1'b0;
+      end
+    end
+
+  end else if (RV32M != RV32MNone) begin : gen_multdiv_direct_sel
+    // Preserve the upstream fast/single-cycle handshake. Only the M1 slow
+    // implementation has an explicit operand-capture boundary to match.
+    assign multdiv_dec_sel = mult_sel_i | div_sel_i;
+    assign multdiv_sel     = multdiv_dec_sel;
   end else begin : gen_multdiv_no_m
-    assign multdiv_sel = 1'b0;
+    assign multdiv_dec_sel = 1'b0;
+    assign multdiv_sel     = 1'b0;
   end
 
