CAPI=2:
# PocketAI-T M1b: two-hart Ibex cluster (Verilator, FUSESoC).
#
# The synthesizable/project RTL is a separate core under rtl/soc. Keeping this
# manifest simulation-only prevents out-of-tree source references and lets the
# run script use narrow core roots that cannot discover rtl/ibex accidentally.
name: "pocketai:pa:pa_cluster:0.1"
description: "PocketAI-T M1b two-hart Ibex cluster"

filesets:
  files_verilator:
    depend:
      - pocketai:pa:pa_cluster_rtl
      - lowrisc:dv_verilator:memutil_verilator
      - lowrisc:dv_verilator:simutil_verilator
    files:
      - pa_cluster.cc: { file_type: cppSource }

targets:
  sim:
    default_tool: verilator
    filesets:
      - tool_verilator ? (files_verilator)
    toplevel: pa_cluster_top
    tools:
      verilator:
        mode: cc
        verilator_options:
          - '-CFLAGS "-std=c++17 -DTOPLEVEL_NAME=pa_cluster_top"'
          - '-LDFLAGS "-pthread -lutil -lelf"'
          - '-Wno-fatal'
