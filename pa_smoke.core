CAPI=2:
# PocketAI-T M1a: single-core Ibex boot smoke (Verilator, FUSESoC).
#
# Mirrors the proven lowRISC ibex FUSESoC reference builds (riscv_compliance /
# simple_system): we depend on `lowrisc:ibex:ibex_top` for the core and
# `lowrisc:ibex:sim_shared` for the bus/RAM/UART helper modules, and add our
# own top (rtl/soc/pa_smoke_top.sv) + Verilator testbench (sim/pa_smoke/).
#
# This core file lives at the IP root (pocketai/) so all file references are
# forward-relative, as FuseSoC expects.
name: "pocketai:pa:pa_smoke:0.1"
description: "PocketAI-T M1a single-core Ibex boot smoke"

filesets:
  files_rtl:
    depend:
      - lowrisc:ibex:ibex_top
      - lowrisc:ibex:sim_shared
    files:
      - rtl/soc/pa_smoke_top.sv
    file_type: systemVerilogSource

  files_verilator:
    depend:
      - lowrisc:dv_verilator:memutil_verilator
      - lowrisc:dv_verilator:simutil_verilator
    files:
      - sim/pa_smoke/pa_smoke.cc: { file_type: cppSource }

targets:
  sim:
    default_tool: verilator
    filesets:
      - files_rtl
      - tool_verilator ? (files_verilator)
    toplevel: pa_smoke_top
    tools:
      verilator:
        mode: cc
        verilator_options:
          - '-CFLAGS "-std=c++17 -DTOPLEVEL_NAME=pa_smoke_top"'
          - '-LDFLAGS "-pthread -lutil -lelf"'
          - '-Wno-fatal'
